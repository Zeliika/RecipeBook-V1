; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rezeptbuch"
run/main_scene="res://scenes/recipe_book_display.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0.580392, 0.764706, 0.407843, 1)
boot_splash/image="res://ui/splash.png"
config/icon="res://ui/app_icon.png"

[autoload]

SceneManager="*res://scripts/utility/scene_manager.gd"
RecipeBookManager="*res://scripts/utility/recipe_book_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=720
window/energy_saving/keep_screen_on=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[dotnet]

project/assembly_name="Rezeptbuch"

[editor_plugins]

enabled=PackedStringArray("res://addons/Todo_Manager/plugin.cfg")

[gui]

theme/custom="res://ui/light_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
