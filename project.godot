; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rezeptbuch"
run/main_scene="res://scenes/recipe_book_display.tscn"
config/features=PackedStringArray("4.0", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SceneManager="*res://scripts/utility/scene_manager.gd"
RecipeBookManager="*res://scripts/utility/recipe_book_manager.gd"

[display]

window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/Todo_Manager/plugin.cfg")

[rendering]

textures/vram_compression/import_etc2_astc=true
